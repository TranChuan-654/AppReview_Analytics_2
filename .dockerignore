*.pyc
*.pyo
*.pyd
.pytest_cache/

# Bỏ qua môi trường ảo địa phương
.venv/
venv/
env/

# Bỏ qua thư mục dữ liệu (để tránh đẩy dữ liệu cào cũ/nặng vào Docker image)
data/

