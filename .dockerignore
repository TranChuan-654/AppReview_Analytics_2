.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

# Bỏ qua các file log hoặc báo cáo tạm thời
*.log
walkthrough.md
implementation_plan.md
task.md

# Bỏ qua thư mục dashboard (chỉ dùng trực tiếp ở máy local của người dùng)
dashboard/

